generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model activos {
  id_activo          Int                 @id @default(autoincrement())
  numero_serie       String              @unique @db.VarChar(100)
  nombre_maquina     String              @db.VarChar(150)
  id_categoria       Int?
  id_estado          Int?
  id_ubicacion       Int?
  id_proyecto        Int?
  id_adquisicion     Int?
  adquisiciones      adquisiciones?      @relation(fields: [id_adquisicion], references: [id_adquisicion], onDelete: NoAction, onUpdate: NoAction)
  categorias_activos categorias_activos? @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  estados_activos    estados_activos?    @relation(fields: [id_estado], references: [id_estado], onDelete: NoAction, onUpdate: NoAction)
  proyectos          proyectos?          @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: NoAction, onUpdate: NoAction)
  ubicaciones        ubicaciones?        @relation(fields: [id_ubicacion], references: [id_ubicacion], onDelete: NoAction, onUpdate: NoAction)
  mantenimientos     mantenimientos[]
  prestamos          prestamos[]
}

model adquisiciones {
  id_adquisicion Int          @id @default(autoincrement())
  numero_factura String       @unique @db.VarChar(100)
  id_proveedor   Int?
  fecha_compra   DateTime     @db.Date
  costo          Decimal      @db.Decimal(10, 2)
  activos        activos[]
  proveedores    proveedores? @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
}

model categorias_activos {
  id_categoria Int       @id @default(autoincrement())
  nombre       String    @unique @db.VarChar(100)
  activos      activos[]
}

model disciplinas {
  id_disciplina Int        @id @default(autoincrement())
  nombre        String     @unique @db.VarChar(100)
  usuarios      usuarios[]
}

model estados_activos {
  id_estado Int       @id @default(autoincrement())
  nombre    String    @unique @db.VarChar(50)
  activos   activos[]
}

model estados_flujo {
  id_estado_flujo Int         @id @default(autoincrement())
  nombre          String      @unique @db.VarChar(50)
  prestamos       prestamos[]
}

model estados_resolucion {
  id_estado_resolucion Int              @id @default(autoincrement())
  nombre               String           @unique @db.VarChar(50)
  mantenimientos       mantenimientos[]
}

model mantenimientos {
  id_mantenimiento     Int                 @id @default(autoincrement())
  id_activo            Int?
  id_reportador        Int?
  id_estado_resolucion Int?
  descripcion          String
  tipo_mantenimiento   String?             @db.VarChar(50)
  fecha_reporte        DateTime?           @default(now()) @db.Timestamp(6)
  fecha_resolucion     DateTime?           @db.Timestamp(6)
  activos              activos?            @relation(fields: [id_activo], references: [id_activo], onDelete: NoAction, onUpdate: NoAction)
  estados_resolucion   estados_resolucion? @relation(fields: [id_estado_resolucion], references: [id_estado_resolucion], onDelete: NoAction, onUpdate: NoAction)
  usuarios             usuarios?           @relation(fields: [id_reportador], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model prestamos {
  id_prestamo                                 Int            @id @default(autoincrement())
  id_activo                                   Int?
  id_solicitante                              Int
  id_lider                                    Int?
  id_aprobador                                Int?
  id_estado_flujo                             Int?
  fecha_solicitud                             DateTime?      @default(now()) @db.Timestamp(6)
  fecha_autorizacion                          DateTime?      @db.Timestamp(6)
  fecha_devolucion_programada                 DateTime       @db.Timestamp(6)
  fecha_salida                                DateTime?      @db.Timestamp(6)
  fecha_devolucion_real                       DateTime?      @db.Timestamp(6)
  activos                                     activos?       @relation(fields: [id_activo], references: [id_activo], onDelete: NoAction, onUpdate: NoAction)
  usuarios_prestamos_id_aprobadorTousuarios   usuarios?      @relation("prestamos_id_aprobadorTousuarios", fields: [id_aprobador], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  estados_flujo                               estados_flujo? @relation(fields: [id_estado_flujo], references: [id_estado_flujo], onDelete: NoAction, onUpdate: NoAction)
  usuarios_prestamos_id_liderTousuarios       usuarios?      @relation("prestamos_id_liderTousuarios", fields: [id_lider], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  usuarios_prestamos_id_solicitanteTousuarios usuarios       @relation("prestamos_id_solicitanteTousuarios", fields: [id_solicitante], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model proveedores {
  id_proveedor  Int             @id @default(autoincrement())
  nombre        String          @db.VarChar(100)
  contacto      String?         @db.VarChar(100)
  adquisiciones adquisiciones[]
}

model proyectos {
  id_proyecto Int       @id @default(autoincrement())
  codigo      String    @unique @db.VarChar(50)
  nombre      String    @db.VarChar(100)
  activos     activos[]
}

model roles {
  id_rol   Int        @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(50)
  usuarios usuarios[]
}

model ubicaciones {
  id_ubicacion Int       @id @default(autoincrement())
  nombre       String    @unique @db.VarChar(100)
  activos      activos[]
}

model usuarios {
  id_usuario                                   Int              @id @default(autoincrement())
  nombre_completo                              String           @db.VarChar(150)
  email                                        String           @unique @db.VarChar(100)
  password_hash                                String           @db.VarChar(255)
  id_rol                                       Int?
  id_disciplina                                Int?
  id_lider                                     Int?
  mantenimientos                               mantenimientos[]
  prestamos_prestamos_id_aprobadorTousuarios   prestamos[]      @relation("prestamos_id_aprobadorTousuarios")
  prestamos_prestamos_id_liderTousuarios       prestamos[]      @relation("prestamos_id_liderTousuarios")
  prestamos_prestamos_id_solicitanteTousuarios prestamos[]      @relation("prestamos_id_solicitanteTousuarios")
  disciplinas                                  disciplinas?     @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction)
  usuarios                                     usuarios?        @relation("usuariosTousuarios", fields: [id_lider], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  other_usuarios                               usuarios[]       @relation("usuariosTousuarios")
  roles                                        roles?           @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
}