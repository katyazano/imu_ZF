generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model roles {
  id_rol             Int                  @id @default(autoincrement())
  nombre             String               @unique @db.VarChar(50)
  aprobaciones_firma aprobaciones_firma[]
  usuarios           usuarios[]
}

model disciplinas_areas {
  id_disciplina Int        @id @default(autoincrement())
  nombre        String     @unique @db.VarChar(100)
  activos       activos[]
  usuarios      usuarios[]
}

model ubicaciones_fisicas {
  id_ubicacion Int       @id @default(autoincrement())
  nombre       String    @unique @db.VarChar(100)
  activos      activos[]
}

model categorias_activos {
  id_categoria      Int                @id @default(autoincrement())
  nombre            String             @unique @db.VarChar(100)
  activos           activos[]
  reglas_aprobacion reglas_aprobacion?
}

model estados_maquina {
  id_estado_maquina Int       @id @default(autoincrement())
  nombre            String    @unique @db.VarChar(50)
  activos           activos[]
}

model tipos_compra {
  id_tipo_compra Int       @id @default(autoincrement())
  nombre         String    @unique @db.VarChar(100)
  activos        activos[]
}

model tipos_nacionalidad {
  id_tipo_nacionalidad Int       @id @default(autoincrement())
  nombre               String    @unique @db.VarChar(100)
  activos              activos[]
}

model destinos_externos {
  id_destino         Int           @id @default(autoincrement())
  nombre_institucion String        @db.VarChar(150)
  tipo               String        @db.VarChar(50)
  contacto_nombre    String        @db.VarChar(150)
  contacto_email     String?       @db.VarChar(100)
  contacto_telefono  String?       @db.VarChar(50)
  solicitudes        solicitudes[]
}

model centros_costo_proyectos {
  id_proyecto Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(150)
  activos     activos[]
}

model usuarios {
  id_usuario                Int                          @id @default(autoincrement())
  nombre_completo           String                       @db.VarChar(150)
  email                     String                       @unique @db.VarChar(100)
  password_hash             String                       @db.VarChar(255)
  id_rol                    Int
  id_disciplina             Int
  id_suplente               Int?
  secreto_2fa               String?                      @db.VarChar(100)
  activo                    Boolean?                     @default(true)
  activos_gerente           activos[]                    @relation("GerenteActivo")
  firmas_realizadas         aprobaciones_firma[]         @relation("UsuarioFirma")
  movimientos_guardia       bitacora_caseta[]            @relation("GuardiaCaseta")
  mantenimientos_reportados mantenimientos_incidencias[] @relation("UsuarioReportador")
  alertas_recibidas         registro_alertas_retrasos[]  @relation("UsuarioInfractor")
  solicitudes_solicitante   solicitudes[]                @relation("UsuarioSolicitante")
  disciplina                disciplinas_areas            @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction)
  rol                       roles                        @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  usuario_suplente          usuarios?                    @relation("Suplencias", fields: [id_suplente], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  suplentes                 usuarios[]                   @relation("Suplencias")
}

model activos {
  id_activo              Int                          @id @default(autoincrement())
  qr_codigo              String                       @unique @db.VarChar(255)
  numero_serie           String                       @unique @db.VarChar(100)
  numero_parte           String?                      @db.VarChar(100)
  marca                  String                       @db.VarChar(100)
  modelo                 String                       @db.VarChar(100)
  anio                   Int?
  nombre_maquina         String                       @db.VarChar(150)
  tag                    String?                      @db.VarChar(100)
  subarea                String?                      @db.VarChar(100)
  descripcion            String?
  comentarios            String?
  cantidad_inicial       Decimal?                     @db.Decimal(10, 2)
  cantidad_actual        Decimal?                     @db.Decimal(10, 2)
  pedimento              String?                      @db.VarChar(100)
  factura                String?                      @db.VarChar(100)
  valor_comercial        Decimal?                     @db.Decimal(15, 2)
  fecha_compra           DateTime?                    @db.Date
  es_compra              Boolean?
  id_disciplina          Int
  id_categoria           Int
  id_estado_maquina      Int
  id_ubicacion           Int
  id_gerente_responsable Int
  id_proyecto            Int?
  id_tipo_compra         Int?
  id_tipo_nacionalidad   Int?
  categoria              categorias_activos           @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  disciplina             disciplinas_areas            @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction)
  estado_maquina         estados_maquina              @relation(fields: [id_estado_maquina], references: [id_estado_maquina], onDelete: NoAction, onUpdate: NoAction)
  gerente                usuarios                     @relation("GerenteActivo", fields: [id_gerente_responsable], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  proyecto               centros_costo_proyectos?     @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: NoAction, onUpdate: NoAction)
  tipo_compra            tipos_compra?                @relation(fields: [id_tipo_compra], references: [id_tipo_compra], onDelete: NoAction, onUpdate: NoAction)
  tipo_nacionalidad      tipos_nacionalidad?          @relation(fields: [id_tipo_nacionalidad], references: [id_tipo_nacionalidad], onDelete: NoAction, onUpdate: NoAction)
  ubicacion              ubicaciones_fisicas          @relation(fields: [id_ubicacion], references: [id_ubicacion], onDelete: NoAction, onUpdate: NoAction)
  mantenimientos         mantenimientos_incidencias[]
  solicitudes            solicitudes[]
}

model solicitudes {
  id_solicitud                Int                          @id @default(autoincrement())
  id_activo                   Int
  id_usuario_solicitante      Int
  id_destino                  Int?
  tipo_salida                 String                       @db.VarChar(50)
  estatus_general             String                       @db.VarChar(50)
  fecha_creacion              DateTime?                    @default(now()) @db.Timestamp(6)
  fecha_salida_programada     DateTime?                    @db.Timestamp(6)
  fecha_devolucion_programada DateTime?                    @db.Timestamp(6)
  metodo_transporte           String                       @db.VarChar(100)
  firmas                      aprobaciones_firma[]
  movimientos_caseta          bitacora_caseta[]
  mantenimientos              mantenimientos_incidencias[]
  alertas                     registro_alertas_retrasos[]
  activo                      activos                      @relation(fields: [id_activo], references: [id_activo], onDelete: NoAction, onUpdate: NoAction)
  destino                     destinos_externos?           @relation(fields: [id_destino], references: [id_destino], onDelete: NoAction, onUpdate: NoAction)
  solicitante                 usuarios                     @relation("UsuarioSolicitante", fields: [id_usuario_solicitante], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model aprobaciones_firma {
  id_firma         Int         @id @default(autoincrement())
  id_solicitud     Int
  id_rol_esperado  Int
  id_usuario_firmo Int?
  estatus_firma    String      @db.VarChar(50)
  comentarios      String?
  fecha_firma      DateTime?   @db.Timestamp(6)
  rol_esperado     roles       @relation(fields: [id_rol_esperado], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  solicitud        solicitudes @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: NoAction, onUpdate: NoAction)
  usuario_firmo    usuarios?   @relation("UsuarioFirma", fields: [id_usuario_firmo], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model reglas_aprobacion {
  id_regla         Int                @id @default(autoincrement())
  id_categoria     Int                @unique
  requiere_gerente Boolean?           @default(true)
  requiere_syr     Boolean?           @default(false)
  requiere_ehs     Boolean?           @default(false)
  categoria        categorias_activos @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
}

model registro_alertas_retrasos {
  id_alerta            Int         @id @default(autoincrement())
  id_solicitud         Int
  id_usuario_infractor Int
  tipo_alerta          String      @db.VarChar(100)
  fecha_envio          DateTime?   @default(now()) @db.Timestamp(6)
  solicitud            solicitudes @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: NoAction, onUpdate: NoAction)
  infractor            usuarios    @relation("UsuarioInfractor", fields: [id_usuario_infractor], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model bitacora_caseta {
  id_bitacora     Int         @id @default(autoincrement())
  id_solicitud    Int
  id_guardia      Int
  tipo_movimiento String      @db.VarChar(50)
  fecha_hora_real DateTime?   @default(now()) @db.Timestamp(6)
  guardia         usuarios    @relation("GuardiaCaseta", fields: [id_guardia], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  solicitud       solicitudes @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: NoAction, onUpdate: NoAction)
}

model mantenimientos_incidencias {
  id_mantenimiento       Int          @id @default(autoincrement())
  id_activo              Int
  id_reportador          Int
  id_solicitud_origen    Int?
  tipo_mantenimiento     String       @db.VarChar(50)
  descripcion            String
  estatus_reparacion     String       @db.VarChar(50)
  fecha_reporte          DateTime?    @default(now()) @db.Timestamp(6)
  fecha_programada       DateTime?    @db.Timestamp(6)
  fecha_resolucion       DateTime?    @db.Timestamp(6)
  comentarios_resolucion String?
  activo                 activos      @relation(fields: [id_activo], references: [id_activo], onDelete: NoAction, onUpdate: NoAction)
  reportador             usuarios     @relation("UsuarioReportador", fields: [id_reportador], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  solicitud              solicitudes? @relation(fields: [id_solicitud_origen], references: [id_solicitud], onDelete: NoAction, onUpdate: NoAction)
}